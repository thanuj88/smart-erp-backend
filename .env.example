PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret
NODE_ENV=development

DEFAULT_TENANT_ID=1

DYNAMODB_TABLE=PosBright
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

APP_URL=http://localhost:3000
# Behind a load balancer or reverse proxy, set how many proxies sit in front of the app (usually 1)
# so audit logs and rate limits see the real client IP. Leave empty when clients connect directly.
# Do not set "true": that trusts every hop and lets clients spoof their IP.
TRUST_PROXY=
SKIP_CAPTCHA=true
SUPER_ADMIN_PASSWORD=superadmin123
DEMO_ADMIN_PASSWORD=admin123
DEMO_TELLER_PASSWORD=teller123
DEMO_TELLER_PIN=1234
DEMO_MANAGER_PASSWORD=manager123
DEMO_ACCOUNTANT_PASSWORD=accountant123
