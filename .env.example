PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret
NODE_ENV=development

DEFAULT_TENANT_ID=1

DYNAMODB_TABLE=PosBright
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

APP_URL=http://localhost:3000
# Outgoing email (verification and password reset). Required in production: without SMTP_HOST,
# public sign-up is refused and reset emails are not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=POSBright <no-reply@example.com>
SKIP_CAPTCHA=true
SUPER_ADMIN_PASSWORD=superadmin123
DEMO_ADMIN_PASSWORD=admin123
DEMO_TELLER_PASSWORD=teller123
DEMO_TELLER_PIN=1234
DEMO_MANAGER_PASSWORD=manager123
DEMO_ACCOUNTANT_PASSWORD=accountant123
