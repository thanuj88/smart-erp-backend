PORT=5000
# Placeholders below only work with NODE_ENV=development or test. Any other NODE_ENV
# (including unset) refuses to boot unless both secrets are unique random values of 32+ characters,
# and JWT_REFRESH_SECRET differs from JWT_SECRET.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret
NODE_ENV=development

DEFAULT_TENANT_ID=1

DYNAMODB_TABLE=PosBright
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

APP_URL=http://localhost:3000
# Extra browser origins allowed to call the API (comma separated). APP_URL is always allowed.
# localhost and 127.0.0.1 are allowed automatically when NODE_ENV is development or test.
CORS_ORIGINS=
# Local development only. Ignored unless NODE_ENV is development or test.
SKIP_CAPTCHA=true
# Sign-in asks for a CAPTCHA after this many failed attempts on one account. Only when
# RECAPTCHA_SECRET is set and SKIP_CAPTCHA is not true. The frontend needs REACT_APP_RECAPTCHA_SITE_KEY.
CAPTCHA_AFTER_FAILURES=3
# Required wherever captcha is not skipped. Without it every captcha check is rejected.
# RECAPTCHA_SECRET=
# Local development only: put verify/reset links in API responses (there is no mailer yet).
# Never honoured when NODE_ENV=production. Leave unset anywhere real users sign up.
EXPOSE_DEV_TOKENS=true
SUPER_ADMIN_PASSWORD=superadmin123
DEMO_ADMIN_PASSWORD=admin123
DEMO_TELLER_PASSWORD=teller123
# Optional. No default PIN is shipped. If set it must be 6 to 8 digits and not a repeat or sequence.
DEMO_TELLER_PIN=
DEMO_MANAGER_PASSWORD=manager123
DEMO_ACCOUNTANT_PASSWORD=accountant123
