PORT=5000
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret
NODE_ENV=development

DEFAULT_TENANT_ID=1

DYNAMODB_TABLE=PosBright
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

APP_URL=http://localhost:3000
# Local development only. Ignored unless NODE_ENV is development or test.
SKIP_CAPTCHA=true
# Local development only: put verify/reset links in API responses (there is no mailer yet).
# Never honoured when NODE_ENV=production. Leave unset anywhere real users sign up.
EXPOSE_DEV_TOKENS=true
# Required wherever captcha is not skipped. Without it every captcha check is rejected.
# RECAPTCHA_SECRET=
SUPER_ADMIN_PASSWORD=superadmin123
DEMO_ADMIN_PASSWORD=admin123
DEMO_TELLER_PASSWORD=teller123
DEMO_TELLER_PIN=1234
DEMO_MANAGER_PASSWORD=manager123
DEMO_ACCOUNTANT_PASSWORD=accountant123
